	ja={chord}は{n}か所で使われています。何も変更されません。;
	}

[{command} on {key}]
	{
	ja={key}に{command};
	}

[{command} with no key]
	{
	ja=キーなしの{command};
	}

[{count} changes of your own]
	{
	ja=自分の変更{count}件;
	}

[{count} commands]
	{
	ja=アクション{count}件;
	}

[{count} of {limit}]
