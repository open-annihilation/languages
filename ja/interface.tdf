	ja={count}/{limit};
	}

[{count} settings changed]
	{
	ja=変更した設定{count}件;
	}

[{count} updates change the game's rules: {names}. Saved games from their current versions won't load under the new ones. Each is kept, and Roll back brings it back.]
	{
	ja={count}件の更新でゲームのルールが変わります：{names}。現在のバージョンのセーブデータは、新しいバージョンではロードできません。それぞれ保管され、ロールバックで元に戻せます。;
	}

[{description} · {chord}]
	{
	ja={description} · {chord};
	}

[{done} of {size} · {percent}%]
	{
	ja={done}/{size} · {percent}%;
	}

[{done} of {whole} s · let go to cancel]
	{
