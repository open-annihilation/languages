	}

[{keys} keys, {helpers} helpers]
	{
	ja=キー{keys}個、ヘルパー{helpers}つ;
	}

[{key} did not count: let go after {held} of {wait} s.]
	{
	ja={key}はカウントされませんでした：{wait}秒のうち{held}で離しました。;
	}

[{key} did not count: pressed again within {wait} s.]
	{
	ja={key}はカウントされませんでした：{wait}秒以内にもう一度押されました。;
	}

[{key} held {held} of {wait} s.]
	{
	ja={key}は{wait}秒のうち{held}押しています。;
	}

[{key} let go.]
	{
