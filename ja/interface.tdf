	ja=命令：命令ページを表示します。;
	}

[BUILD]
	{
	ja=建設;
	}

[BUILD: shows the build pages.]
	{
	ja=建設：建設ページを表示します。;
	}

[PREV]
	{
	ja=前へ;
	}

[PREV: shows the build page before this one.]
