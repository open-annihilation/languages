	pl=RUCH: stuknij, by uzbroić, potem stuknij, dokąd ma iść zaznaczenie.;
	}

[ATTACK: tap to arm it, then tap the unit or ground to fire at.]
	{
	pl=ATAK: stuknij, by uzbroić, potem stuknij w jednostkę albo ziemię do ostrzału.;
	}

[PATROL: tap to arm it, then tap the points to patrol between.]
	{
	pl=PATROL: stuknij, by uzbroić, potem stuknij w punkty patrolu.;
	}

[GUARD: tap to arm it, then tap the unit to guard.]
	{
	pl=OCHRONA: stuknij, by uzbroić, potem stuknij w jednostkę do ochrony.;
	}

[D-GUN: tap to arm it, then tap where the commander fires it.]
	{
	pl=D-GUN: stuknij, by uzbroić, potem stuknij tam, gdzie strzela Dowódca.;
	}

[RECLAIM: tap to arm it, then tap the wreck or unit to reclaim.]
	{
	pl=ODZYSK: stuknij, by uzbroić, potem stuknij we wrak albo jednostkę do odzysku.;
	}

[REPAIR: tap to arm it, then tap the unit to repair or help build.]
	{
	pl=NAPRAWA: stuknij, by uzbroić, potem stuknij w jednostkę do naprawy albo do pomocy w budowie.;
	}

[CAPTURE: tap to arm it, then tap the unit to capture.]
	{
