	pl=Paczka zawiera {name}, poza plikami, które może mieć mózg.;
	}

[Its network {name} does not match the SHA-256 its oabrain.yaml gives.]
	{
	pl=Jego sieć {name} nie zgadza się z SHA-256 podanym w jego oabrain.yaml.;
	}

[Its network {name} is missing.]
	{
	pl=Brakuje jego sieci {name}.;
	}

[Its networks take {size}, more than the {limit} a brain may hold.]
	{
	pl=Jego sieci zajmują {size}, a mózg może pomieścić najwyżej {limit}.;
	}

[Its table {name} is larger than 4 MiB.]
	{
	pl=Jego tabela {name} jest większa niż 4 MiB.;
	}

[{name} is precompiled Lua. A brain holds Lua source only.]
	{
	pl={name} to wstępnie skompilowany Lua. Mózg trzyma tylko kod źródłowy Lua.;
	}

[{name} is installed. Choose it for a computer player when you set up a game.]
	{
	pl={name} jest zainstalowany. Wybierz go jako komputer, gdy ustawiasz partię.;
	}

// When a brain stops, and saves and recordings that name a brain.

[{brain} could not start ({reason}); the engine plays this seat]
	{
	pl={brain} nie uruchomił się ({reason}), tym miejscem gra silnik;
	}

[{brain} does not fit this game ({reason}); the engine plays this seat]
	{
	pl={brain} nie pasuje do tej partii ({reason}), tym miejscem gra silnik;
	}

[{brain} stopped ({reason}); the engine plays this seat on]
	{
	pl={brain} zatrzymał się ({reason}), tym miejscem dalej gra silnik;
	}

[The computer players this game was saved with cannot be read.]
	{
	pl=Nie można odczytać komputerów, z którymi zapisano tę partię.;
	}

[This game was saved with {name} {version} playing seat {n}, which is not installed here.]
	{
	pl=Tę partię zapisano, gdy miejsce {n} zajmował {name} {version}, a tutaj go nie zainstalowano.;
	}

[Load with the built-in player?]
	{
	pl=Wczytać z wbudowanym graczem?;
	}

[This saved game needs {name} {version}, which is not installed.]
	{
	pl=Ten zapis gry wymaga {name} {version}, którego nie zainstalowano.;
	}

