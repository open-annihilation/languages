	{
	bn=*** {host} মিউটেটর চালু করেছে: {list};
	}

[*** {list}]
	{
	bn=*** {list};
	}

[*** {player} chose a side this game does not have.]
	{
	bn=*** {player} এমন পক্ষ বেছেছে যা এই লড়াইতে নেই.;
	}

[*** {player} does not have {name}.]
	{
	bn=*** {player}-এর কাছে {name} নেই.;
	}

[*** {player} plays Total Annihilation 3.1c and cannot join a game with mutators.]
	{
	bn=*** {player} Total Annihilation 3.1c খেলে এবং মিউটেটরসহ লড়াইতে যোগ দিতে পারে না.;
	}

[*** {player} plays Total Annihilation 3.1c, which cannot play with mutators.]
	{
	bn=*** {player} Total Annihilation 3.1c খেলে, যা মিউটেটর দিয়ে খেলতে পারে না.;
	}

[*** You do not have {name}.]
	{
	bn=*** তোমার কাছে {name} নেই.;
	}

[*** You do not have {name}. GET MUTATORS downloads it from {registry}.]
	{
	bn=*** তোমার কাছে {name} নেই. মিউটেটর নাও সেটা {registry} থেকে নামায়.;
	}

[*** You do not have {names}.]
	{
	bn=*** তোমার কাছে {names} নেই.;
	}

[*** You do not have {names}. GET MUTATORS downloads them from {registry}.]
	{
	bn=*** তোমার কাছে {names} নেই. মিউটেটর নাও সেগুলো {registry} থেকে নামায়.;
	}

[Different from the host: another release of {name}.]
	{
	bn=হোস্টের থেকে আলাদা: {name}-এর অন্য সংস্করণ.;
	}

[Downloads are off.]
	{
	bn=নামানো বন্ধ.;
	}

[Ready once {name} is here]
