	}

[CAPTURE: the selection captures the unit at the held point.]
	{
	tr=ELE GEÇ: seçim basılı tutulan noktadaki birimi ele geçirir.;
	}

[STOP: the selection stops at once.]
	{
	tr=DUR: seçim hemen durur.;
	}

