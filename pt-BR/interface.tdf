[MOVE: the selection moves to the held point.]
	{
	pt-BR=MOVER: a seleção se move até o ponto pressionado.;
	}

[PATROL: the selection patrols to the held point.]
	{
	pt-BR=PATRULHAR: a seleção patrulha até o ponto pressionado.;
	}

[ATTACK: the selection attacks the unit or ground at the held point.]
	{
	pt-BR=ATACAR: a seleção ataca a unidade ou o chão no ponto pressionado.;
	}

[D-GUN: the commander fires the D-gun at the held point.]
	{
	pt-BR=D-GUN: o Comandante dispara a D-Gun no ponto pressionado.;
	}

[LOAD: the transport loads the unit at the held point.]
	{
	pt-BR=CARREGAR: o transporte carrega a unidade no ponto pressionado.;
	}

[CAPTURE: the selection captures the unit at the held point.]
	{
	pt-BR=CAPTURAR: a seleção captura a unidade no ponto pressionado.;
	}

[STOP: the selection stops at once.]
	{
	pt-BR=PARAR: a seleção para na hora.;
	}

