	ru=Клавиша {key} остаётся нажатой, пока её не нажмут ещё раз.;
	}

[{layout} · 1 change]
	{
	ru={layout} · 1 изменение;
	}

[{layout} · {n} changes]
	{
	ru={layout} · изменения: {n};
	}

[{modifier} · locked]
	{
	ru={modifier} · зафиксировано;
	}

[{modifier} · next key or click]
	{
	ru={modifier} · следующая клавиша или щелчок;
	}

[{name} ({count})]
	{
	ru={name} ({count});
	}

[{name} already has 1 change of your own; it stays.]
	{
	ru={name} уже содержит 1 своё изменение. Оно остаётся.;
	}

[{name} already has {count} changes of your own; they stay.]
	{
	ru={name} уже содержит свои изменения: {count}. Они остаются.;
	}

[{name} from {installed} is installed. Replace it with {name} from {new}? The one from {installed} is kept, and Roll back brings it back.]
	{
	ru=Установлен мод {name} из {installed}. Заменить его модом {name} из {new}? Версия из {installed} сохранится, и ОТКАТИТЬ вернёт её.;
	}

[{name} uses it {context}. Choose what happens; nothing changes until you confirm.]
	{
	ru={name} использует её {context}. Выберите, что произойдёт. Ничего не изменится, пока вы не подтвердите.;
	}

[{name} uses it. Nothing changes until you choose.]
	{
	ru={name} использует её. Ничего не изменится, пока вы не выберете.;
	}

[{name} · 1 change of your own]
	{
	ru={name} · 1 своё изменение;
	}

[{name} · Add from…]
	{
	ru={name} · ДОБАВИТЬ ИЗ…;
	}

[{name} · made for {mod}]
	{
	ru={name} · сделано для мода {mod};
	}

[{name} · {n} changes]
	{
	ru={name} · изменения: {n};
	}

[{name} · {n} changes of your own]
	{
	ru={name} · свои изменения: {n};
	}

[{name}: {description} {context}. OK asks what to do.]
	{
	ru={name}: {description} {context}. OK спросит, что делать.;
